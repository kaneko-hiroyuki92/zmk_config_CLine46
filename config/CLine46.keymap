#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-input-processor.dtsi>
#include <mouse-gesture.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&rip_hdpi {
    scale-multiplier = <2>;
    scale-divisor = <1>;
};

&rip_ldpi {
    scale-multiplier = <1>;
    scale-divisor = <3>;
};

&zip_mouse_gesture {
    stroke-size = <200>;
    enable-eager-mode;
    suppress-movement;

    gesture_copy {
        pattern = <GESTURE_UP>;
        bindings = <&kp LC(C)>;
    };

    gesture_paste {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp LC(V)>;
    };

    gesture_cut {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LC(X)>;
    };

    gesture_shift_paste {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LC(LS(V))>;
    };
};

/ {
    zip_screenshot_gesture: zip_screenshot_gesture {
        compatible = "zmk,input-processor-mouse-gesture";
        #input-processor-cells = <0>;
        stroke-size = <200>;
        enable-eager-mode;
        suppress-movement;

        gesture_screenshot {
            pattern = <GESTURE_UP>;
            bindings = <&kp PSCRN>;
        };

        gesture_next_tab {
            pattern = <GESTURE_RIGHT>;
            bindings = <&kp LC(TAB)>;
        };

        gesture_previous_tab {
            pattern = <GESTURE_LEFT>;
            bindings = <&kp LC(LS(TAB))>;
        };

        gesture_task_view {
            pattern = <GESTURE_DOWN>;
            bindings = <&kp LG(TAB)>;
        };

        gesture_desktop_previous {
            pattern = <GESTURE_DOWN GESTURE_LEFT>;
            bindings = <&kp LC(LG(LEFT))>;
        };

        gesture_desktop_next {
            pattern = <GESTURE_DOWN GESTURE_RIGHT>;
            bindings = <&kp LC(LG(RIGHT))>;
        };
    };
};

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_f7_l0 {
            bindings = <&kp F7>;
            key-positions = <7 8>;
            layers = <0 5>;
        };

        combo_f8_l0 {
            bindings = <&kp F8>;
            key-positions = <8 9>;
            layers = <0 5>;
        };

        coron {
            bindings = <&kp APOS>;
            key-positions = <20 19>;
            layers = <5>;
        };

        FandP {
            bindings = <&FandP>;
            key-positions = <10 2>;
            layers = <0>;
        };

        tabmove1 {
            bindings = <&kp LC(TAB)>;
            key-positions = <15 16>;
            layers = <0>;
        };

        tabmove2 {
            bindings = <&kp LC(LS(TAB))>;
            key-positions = <15 14>;
            layers = <0>;
        };

        CtlA {
            bindings = <&kp LC(A)>;
            key-positions = <16 40>;
            layers = <0>;
        };

        WinE {
            bindings = <&kp LG(E)>;
            key-positions = <3 40>;
            layers = <0>;
        };

        CtlZ {
            bindings = <&kp LC(Z)>;
            key-positions = <15 40>;
            layers = <0>;
        };

        Home {
            bindings = <&kp HOME>;
            key-positions = <8 9>;
            layers = <1>;
        };

        End {
            bindings = <&kp END>;
            key-positions = <20 21>;
            layers = <1>;
        };

        Alt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <20 43>;
            layers = <0>;
            slow-release;
        };
    };

    macros {
        FandP: FandP {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_2 &kp LS(F) &kp A &kp N &kp D &kp LS(P) &kp N5 &kp NUMBER_2 &kp N9>;
            label = "FANDP";
        };

        PC_shutdown: PC_shutdown {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <30>;
            wait-ms = <30>;
            bindings =
                <&kp LG(X)>,
                <&macro_wait_time 500>,
                <&kp U>,
                <&macro_wait_time 300>,
                <&kp H>;
        };

        screenshot_gesture_key: screenshot_gesture_key {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&mouse_gesture &mo 5>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 5 &mouse_gesture>;

            label = "SCREENSHOT_GESTURE";
        };
    };

    behaviors {
        esc_mouse_lt: esc_mouse_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            hold-while-undecided;
            bindings = <&mo>, <&kp>;
        };

        PC_shutdown2: PC_shutdown2 {
            compatible = "zmk,behavior-tap-dance";
            label = "PC_SHUTDOWN2";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&none>, <&PC_shutdown>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&esc_mouse_lt 2 ESCAPE  &kp Q             &kp W     &kp E     &kp R             &kp T                                              &kp Y          &kp U  &kp I      &kp O    &kp P      &lt 3 LEFT_BRACKET
&kp TAB                  &kp A             &kp S     &kp D     &lt 5 F           &kp G                                              &kp H          &kp J  &kp K      &kp L    &kp MINUS  &kp SINGLE_QUOTE
&kp LSHIFT               &kp Z             &kp X     &kp C     &kp V             &kp B                                              &kp N          &kp M  &kp COMMA  &kp DOT  &kp SLASH  &kp INTERNATIONAL_1
                         &kp LEFT_CONTROL  &kp LGUI  &kp LALT  &lt 4 LANGUAGE_2  &lt 1 LANGUAGE_1  &mt LEFT_SHIFT SPACE    &kp RET  &kp BACKSPACE                    &none    &kp DEL
            >;
        };

        layer_1 {
            bindings = <
&none   &kp LG(DOWN)       &kp LG(LEFT)      &kp LG(UP)         &kp LG(RIGHT)     &none                    &kp LC(MINUS)          &kp F2     &kp UP     &kp K_APPLICATION  &kp PRINTSCREEN   &PC_shutdown2
&none   &kp F4             &kp LS(LG(LEFT))  &kp LG(LS(RIGHT))  &kp LC(NUMBER_1)  &none                    &kp LC(LS(SEMICOLON))  &kp LEFT   &kp DOWN   &kp RIGHT          &none             &kp LC(S)
&trans  &kp LC(SEMICOLON)  &kp LC(APOS)      &none              &kp LS(LC(N))     &none                    &kp LC(X)              &kp LC(C)  &kp LC(V)  &kp LC(LS(V))      &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))
        &trans             &none             &none              &none             &none  &none    &kp RET  &kp BSPC                                     &none              &none
            >;
        };

        MOUSE {
            bindings = <
&none  &none  &none  &none  &none  &none                    &none     &none     &mouse_gesture  &screenshot_gesture_key  &none  &none
&none  &none  &none  &none  &none  &none                    &none     &mkp MB1  &mkp MB3        &mkp MB2                 &mo 3  &rip_hdpi
&none  &none  &none  &none  &none  &none                    &none     &mkp MB4  &none           &mkp MB5                 &none  &rip_ldpi
       &none  &none  &none  &none  &none  &none    &kp RET  &kp BSPC                            &none                    &none
            >;
        };

        SCROLL {
            bindings = <
&bt BT_CLR      &trans        &trans        &trans        &trans        &trans                                  &trans  &trans            &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &trans                                  &trans  &kp LEFT_CONTROL  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &trans                                  &trans  &trans            &trans  &trans  &trans  &trans
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans    &studio_unlock  &trans                            &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&none  &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(N5)                  &kp LS(NUMBER_6)  &kp LS(N7)         &kp LS(N8)       &kp LS(N9)           &kp MINUS      &kp EQUAL
&none  &none             &none             &none             &none             &none                       &none             &kp RIGHT_BRACKET  &kp NON_US_HASH  &kp INTERNATIONAL_3  &kp SEMICOLON  &kp APOS
&none  &none             &none             &none             &none             &none                       &none             &none              &none            &none                &none          &none
       &none             &none             &none             &none             &none       &none    &none  &kp LEFT_SHIFT                                        &none                &none
            >;
        };

        SCREENSHOT {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                       &trans           &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_SLASH     &trans
&trans  &trans  &trans  &trans  &trans  &trans                       &kp PERCENT      &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MULTIPLY  &trans
&trans  &trans  &trans  &trans  &trans  &trans                       &kp LS(MINUS)    &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_MINUS     &trans
        &trans  &trans  &trans  &trans  &trans  &trans    &kp ENTER  &kp KP_NUMBER_0                                    &kp KP_DOT       &kp KP_PLUS
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                  &trans  &trans
            >;
        };
    };
};
