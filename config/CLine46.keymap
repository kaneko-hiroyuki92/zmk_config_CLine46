#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        combo_f7_l0 {
            bindings = <&kp F7>;
            key-positions = <7 8>;
            layers = <0>;
        };

        combo_f7_mouse {
            bindings = <&kp F7>;
            key-positions = <3 2>;
            layers = <3>;
        };

        combo_f8_mouse {
            bindings = <&kp F8>;
            key-positions = <3 4>;
            layers = <3>;
        };

        combo_f8_l0 {
            bindings = <&kp F8>;
            key-positions = <8 9>;
            layers = <0>;
        };

        coron {
            bindings = <&kp APOS>;
            key-positions = <14 15>;
            layers = <3>;
        };

        FandP {
            bindings = <&FandP>;
            key-positions = <10 2>;
            layers = <0>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        FandP: FandP {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_2 &kp LS(F) &kp A &kp N &kp D &kp LS(P) &kp N5 &kp NUMBER_2 &kp N9>;
            label = "FANDP";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        ht_bspc: ht_bspc {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_BSPC";
            bindings = <&kp>, <&none>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        MO4: MO4 {
            compatible = "zmk,behavior-tap-dance";
            label = "MO4";
            #binding-cells = <0>;
            bindings = <&lt 4 BACKSPACE>, <&ht_bspc BACKSPACE 0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESCAPE  &kp Q             &kp W     &kp E     &kp R             &kp T                                              &kp Y          &kp U    &kp I      &kp O    &kp P      &kp LEFT_BRACKET
&kp TAB     &kp A             &kp S     &kp D     &kp F             &kp G                                              &kp H          &lt 2 J  &kp K      &kp L    &kp MINUS  &kp SINGLE_QUOTE
&kp LSHIFT  &kp Z             &kp X     &kp C     &kp V             &kp B                                              &kp N          &kp M    &kp COMMA  &kp DOT  &kp SLASH  &kp INTERNATIONAL_1
            &kp LEFT_CONTROL  &kp LGUI  &kp LALT  &lt 4 LANGUAGE_2  &lt 1 LANGUAGE_1  &mt LEFT_SHIFT SPACE    &kp RET  &kp BACKSPACE                      &none    &kp DEL
            >;
        };

        layer_1 {
            bindings = <
&none  &kp LG(DOWN)       &kp LG(LEFT)      &kp LG(UP)         &kp LG(RIGHT)     &none                    &kp LC(MINUS)          &kp F2     &kp UP     &kp K_APPLICATION  &kp PRINTSCREEN   &none
&none  &kp F4             &kp LS(LG(LEFT))  &kp LG(LS(RIGHT))  &kp LC(NUMBER_1)  &none                    &kp LC(LS(SEMICOLON))  &kp LEFT   &kp DOWN   &kp RIGHT          &none             &kp LC(S)
&none  &kp LC(SEMICOLON)  &kp LC(APOS)      &none              &kp LS(LC(N))     &none                    &kp LC(X)              &kp LC(C)  &kp LC(V)  &kp LC(LS(V))      &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))
       &none              &none             &none              &none             &none  &none    &kp RET  &kp BSPC                                     &none              &none
            >;
        };

        MOUSE {
            bindings = <
&kp ESCAPE  &kp LS(N5)  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_SLASH                       &none     &none     &none     &none     &none  &none
&none       &none       &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_ASTERISK                    &none     &mkp MB1  &mkp MB3  &mkp MB2  &mo 3  &kp F23
&none       &none       &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_MINUS                       &none     &mkp MB4  &none     &mkp MB5  &none  &kp F24
            &none       &kp KP_NUMBER_0  &kp PERIOD       &none            &kp KP_PLUS      &none    &kp RET  &kp BSPC                      &none     &none
            >;
        };

        SCROLL {
            bindings = <
&bt BT_CLR      &trans  &trans        &trans        &trans        &trans                                      &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &trans  &bt BT_SEL 4  &trans        &trans        &trans                                      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &bt BT_SEL 0  &trans        &trans        &trans  &kp LEFT_CONTROL    &studio_unlock  &trans                  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&none  &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(N5)                  &kp LS(NUMBER_6)  &kp LS(N7)         &kp LS(N8)       &kp LS(N9)  &kp MINUS      &kp EQUAL
&none  &none             &none             &none             &none             &none                       &none             &kp RIGHT_BRACKET  &kp NON_US_HASH  &none       &kp SEMICOLON  &kp APOS
&none  &none             &none             &none             &none             &none                       &none             &none              &none            &none       &none          &none
       &none             &none             &none             &none             &none       &none    &none  &kp LEFT_SHIFT                                        &none       &none
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                  &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                  &trans  &trans
            >;
        };
    };
};
